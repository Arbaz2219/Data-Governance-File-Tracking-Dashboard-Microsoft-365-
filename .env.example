# M365 Authentication Credentials
TENANT_ID="your_tenant_id_here"
CLIENT_ID="your_client_id_here"
CLIENT_SECRET="your_client_secret_here"

# App registration of the dashboard SPA (client/src/authConfig.js). Privileged
# routes such as the remote reboot verify the caller's ID token against this
# audience. Not a secret - it already ships in the browser bundle. Optional:
# the server falls back to the current SPA client id if unset.
SPA_CLIENT_ID="your_spa_client_id_here"
